# ==============================================================================
# PERFECT FLOW - Environment Variables Configuration
# ==============================================================================
# Copy the values from your existing Whiteboard (Perfect Board) / Perfect Call .env.local

# 1. Supabase Database Connection
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Vercel / Sub-path Deployment
# Ensures all assets and routes resolve at https://perfectcall.app/flow
NEXT_PUBLIC_BASE_PATH=/flow
